{
  "name": "watchtower",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4350",
    "build": "astro build",
    "preview": "astro preview --port 4350",
    "gate": "astro check && vp check && astro build",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && vp config --no-agent || true"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0",
    "lightweight-charts": "^5.2.1",
    "motion": "^14.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/three": "^0.186.0",
    "typescript": "6",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  }
}
