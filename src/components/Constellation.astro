---
// Market constellation: a three.js point cloud, one point per coin, behind the global banner.
// Markup only here; the scene lives in src/scripts/constellation.ts.
---

<div class="constellation" data-constellation>
  <canvas aria-hidden="true"></canvas>
  <p class="caption">250 coins. Size is market cap, colour is 24h change.</p>
  <button type="button" class="ctrl scene-toggle" data-scene-toggle data-pause="Pause" data-play="Play" aria-pressed="false" hidden>Pause</button>
</div>

<style>
  /* The gradient is also the static fallback when the scene never starts. */
  .constellation {
    position: relative;
    height: 260px;
    overflow: hidden;
    background:
      radial-gradient(ellipse 50% 85% at 50% 50%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .constellation::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 40%, var(--surface) 100%);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  canvas.is-live {
    opacity: 1;
  }
  .caption {
    position: absolute;
    left: 16px;
    bottom: 12px;
    z-index: 1;
    max-width: calc(100% - 110px);
    margin: 0;
    font-size: 12px;
    color: var(--muted);
    text-shadow: 0 0 6px var(--surface), 0 0 12px var(--surface);
  }
  .scene-toggle {
    position: absolute;
    right: 12px;
    bottom: 10px;
    z-index: 1;
    height: 28px;
    padding: 0 12px;
    font-size: 12px;
  }
  .scene-toggle[hidden] {
    display: none;
  }
  @media (max-width: 767px) {
    .constellation {
      height: 200px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    canvas {
      transition: none;
    }
  }
</style>

<script>
  import "../scripts/constellation-boot";
</script>
